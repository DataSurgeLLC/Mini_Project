        "SELECT * FROM mini_project.gold_layer.date_dim"
      ]
    },
    {
      "name": "03853027",
      "displayName": "Total Sales by Product",
      "queryLines": [
        "SELECT p.name, s.order_qty * ((1 - s.unit_price_discount) * (s.unit_price)) as sales FROM mini_project.gold_layer.product p \r\n",
        "LEFT JOIN mini_project.gold_layer.sales_order s ON p.product_id = s.product_id\r\n",
        "WHERE s.status = 'Shipped' order by sales desc limit 10 "
      ]
    },
    {
      "name": "4cb35d84",
      "displayName": "Average Days to Manufacture by Product",
      "queryLines": [
        "SELECT product_subcategory, AVG(days_to_manufacture) as average_days_to_manufacture \r\n",
        "FROM mini_project.gold_layer.product group by product_subcategory order by average_days_to_manufacture desc limit 10"
      ]
    }
  ],
