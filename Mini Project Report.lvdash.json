    },
    {
      "name": "a86fa395",
      "displayName": "Reporting Dataset",
      "queryLines": [
        "WITH purchases AS (\r\n",
        "  SELECT\r\n",
        "    po.product_id,\r\n",
        "    dd.year,\r\n",
        "    dd.month,\r\n",
        "    dd.month_name,\r\n",
        "    SUM(CAST(po.order_qty AS DECIMAL(38,6))) AS purchase_qty,\r\n",
        "    SUM(CAST(po.order_qty AS DECIMAL(38,6)) * CAST(po.unit_price AS DECIMAL(38,6))) AS purchase_amount\r\n",
        "  FROM  mini_project.gold_layer.purchase_order po\r\n",
        "  JOIN  mini_project.gold_layer.date_dim dd\r\n",
        "    ON dd.date = CAST(po.order_date AS DATE)\r\n",
        "  WHERE LOWER(po.status) = 'complete'\r\n",
        "  GROUP BY\r\n",
        "    po.product_id, dd.year, dd.month, dd.month_name\r\n",
        "),\r\n",
        "sales AS (\r\n",
        "  SELECT\r\n",
        "    so.product_id,\r\n",
        "    dd.year,\r\n",
        "    dd.month,\r\n",
        "    dd.month_name,\r\n",
        "    SUM(CAST(so.order_qty AS DECIMAL(38,6))) AS sales_qty,\r\n",
        "    SUM(\r\n",
        "      CAST(so.order_qty AS DECIMAL(38,6))\r\n",
        "      * (CAST(so.unit_price AS DECIMAL(38,6)) - CAST(so.unit_price_discount AS DECIMAL(38,6)))\r\n",
        "    ) AS sales_amount\r\n",
        "  FROM  mini_project.gold_layer.sales_order so\r\n",
        "  JOIN  mini_project.gold_layer.date_dim dd\r\n",
        "    ON dd.date = CAST(so.order_date AS DATE)\r\n",
        "  WHERE LOWER(so.status) = 'shipped'\r\n",
        "  GROUP BY\r\n",
        "    so.product_id, dd.year, dd.month, dd.month_name\r\n",
        "),\r\n",
        "monthly_product AS (\r\n",
        "  SELECT\r\n",
        "    COALESCE(s.product_id, p.product_id) AS product_id,\r\n",
        "    COALESCE(s.year, p.year)             AS year,\r\n",
        "    COALESCE(s.month, p.month)           AS month,\r\n",
        "    COALESCE(s.month_name, p.month_name) AS month_name,\r\n",
        "    COALESCE(s.sales_qty, 0)             AS sales_qty,\r\n",
        "    COALESCE(s.sales_amount, 0)          AS sales_amount,\r\n",
        "    COALESCE(p.purchase_qty, 0)          AS purchase_qty,\r\n",
        "    COALESCE(p.purchase_amount, 0)       AS purchase_amount\r\n",
        "  FROM sales s\r\n",
        "  FULL OUTER JOIN purchases p\r\n",
        "    ON s.product_id = p.product_id\r\n",
        "   AND s.year = p.year\r\n",
        "   AND s.month = p.month\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "  pr.name AS product_name,\r\n",
        "  pr.product_subcategory AS product_subcategory,\r\n",
        "  pr.product_category AS product_category,\r\n",
        "  pr.days_to_manufacture AS days_to_manufacture,\r\n",
        "  mp.year,\r\n",
        "  mp.month,\r\n",
        "  mp.month_name,\r\n",
        "  CONCAT(CAST(mp.year AS STRING), '-', LPAD(CAST(mp.month AS STRING), 2, '0')) AS year_month,\r\n",
        "  TO_TIMESTAMP(CONCAT(CAST(mp.year AS STRING), '-', LPAD(CAST(mp.month AS STRING), 2, '0'), '-01 00:00:00')) AS month_start_ts,\r\n",
        "  mp.sales_qty,\r\n",
        "  mp.sales_amount,\r\n",
        "  mp.purchase_qty,\r\n",
        "  mp.purchase_amount,\r\n",
        "  sales_amount - purchase_amount AS net_amount\r\n",
        "FROM monthly_product mp\r\n",
        "JOIN  mini_project.gold_layer.product pr\r\n",
        "  ON pr.product_id = mp.product_id\r\n",
        "ORDER BY pr.name, mp.year, mp.month;"
      ]
    }
  ],
